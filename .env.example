# --- LLM ------------------------------------------------------------------
OPENAI_API_KEY=sk-...
CLIPAGENT_MODEL=gpt-4o-mini
# Langue de travail de l'agent (transcription, titres)
CLIPAGENT_LANGUAGE=fr

# --- Fournisseur compatible OpenAI (optionnel) ---------------------------
# NVIDIA NIM (build.nvidia.com) :
#   OPENAI_API_KEY=nvapi-...
#   CLIPAGENT_BASE_URL=https://integrate.api.nvidia.com/v1
#   CLIPAGENT_MODEL=meta/llama-3.1-70b-instruct
# Ollama local : CLIPAGENT_BASE_URL=http://localhost:11434/v1
# vLLM local   : CLIPAGENT_BASE_URL=http://localhost:8000/v1
CLIPAGENT_BASE_URL=
# true = API Chat Completions (obligatoire pour un endpoint sans /responses)
CLIPAGENT_CHAT_COMPLETIONS=false
# false = n'envoyer pas le schéma JSON strict des outils (certains endpoints le refusent)
CLIPAGENT_STRICT_TOOLS=true

# --- Réglages de clipping -------------------------------------------------
CLIPAGENT_NUM_CLIPS=5
CLIPAGENT_MIN_CLIP=20
CLIPAGENT_MAX_CLIP=90
CLIPAGENT_ASPECT=9:16
CLIPAGENT_WIDTH=1080
CLIPAGENT_HEIGHT=1920
CLIPAGENT_BURN_SUBTITLES=true

# --- Outils ---------------------------------------------------------------
# Chemin de l'exécutable ffmpeg (sinon PATH, sinon imageio-ffmpeg)
FFMPEG_BINARY=
FFPROBE_BINARY=
# Exemple : C:\Program Files\ffmpeg\bin\ffmpeg.exe

# --- Sorties --------------------------------------------------------------
CLIPAGENT_OUTPUT_DIR=output
CLIPAGENT_VERBOSE=false
